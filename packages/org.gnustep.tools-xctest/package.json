      "clang"
    ],
    "supported_objc_runtimes": [
      "libobjc2"
    ],
    "supported_objc_abi": [
      "modern"
    ],
    "required_features": [
      "blocks"
    ],
    "forbidden_features": [],
    "gnustep_make": true,
    "toolchain_components": [
      "gnustep-make"
    ]
  },
