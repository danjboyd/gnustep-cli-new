    "upstream_url": "https://github.com/gnustep/tools-xctest",
    "fork": "danjboyd/tools-xctest",
    "fork_url": "https://github.com/danjboyd/tools-xctest",
    "tracking_strategy": "tagged-fork-release",
    "update_cadence": "manual-per-fork-release",
    "channel_policy": "stable tracks a tagged danjboyd/tools-xctest release, pinned by tag and commit, under the maintainer's fork-pin exception (AIManager ask #3024). The fork is 212 commits past upstream master 5c84fc3 and converges upstream piece by piece.",
    "sha256_method": "git -c core.autocrlf=false -c core.eol=lf archive --format=tar.gz <revision> | sha256sum",
    "provides_natively": [
      "add-apple-style-xctest-cli-filters"
    ],
    "provides_natively_notes": "v0.8.0 and later implement Apple-style -only-testing:/-skip-testing: itself (fork CHANGELOG 0.2-0.4), so the downstream patch that added them is no longer carried. The package build still checks that xctest --help lists both filters."
  },
