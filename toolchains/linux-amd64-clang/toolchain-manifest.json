{
  "schema_version": 1,
  "kind": "managed-toolchain",
  "toolchain_version": "2026.04.0",
  "target": {
    "id": "linux-amd64-clang",
    "os": "linux",
    "arch": "amd64",
    "compiler_family": "clang",
    "toolchain_flavor": "clang"
  },
  "runtime": {
    "objc_runtime": "libobjc2",
    "objc_abi": "modern",
    "required_features": [
      "blocks"
    ]
  },
  "components": [
    "libobjc2",
    "libdispatch",
    "tools-make",
    "libs-base",
    "libs-corebase",
    "libs-gui",
    "libs-back"
  ],
  "published": true,
  "platform_policy": {
    "supported_distributions": [
      "debian"
    ],
    "portability_policy": "distribution-scoped",
    "supported_distribution_releases": [
      "debian-13"
    ],
    "deprecated_distribution_releases": [
      "debian-12"
    ],
    "notes": "Current source-built Linux artifact is built on Debian 13 trixie (glibc 2.41, ICU 76) and validated on Debian only; Debian 12 bookworm is deprecated and its ICU 72 artifacts do not load on Debian 13. Fedora and Arch require dependency closure or per-distro artifacts before managed artifact support is claimed."
  },
  "build_environment": {
    "base_image": "debian:13",
    "distribution": "debian",
    "distribution_release": "trixie",
    "dockerfile": "Dockerfile",
    "glibc_floor": "2.41",
    "icu_major": "76",
    "deprecated_bases": [
      "debian:12"
    ]
  },
  "source_policy": {
    "strategy": "source-build",
    "production_eligible": true,
    "lock_file": "source-lock.json",
    "component_inventory": "component-inventory.json",
    "host_origin_paths_allowed": false
  }
}
