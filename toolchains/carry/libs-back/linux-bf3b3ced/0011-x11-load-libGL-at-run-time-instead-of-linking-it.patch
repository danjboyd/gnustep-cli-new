@@ -0,0 +1,90 @@
+/* 	-*-ObjC-*- */
+/* XGGLLoader - the GLX and GL functions of the x11 backend, loaded from
+   libGL at run time
+
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+   This file is part of the GNUstep GUI Library.
