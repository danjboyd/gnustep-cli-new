From 49f443eb27aadb2950cb39d0adb5a99ed4f9ad23 Mon Sep 17 00:00:00 2001
From: Daniel Boyd <danieljboyd@icloud.com>
Date: Tue, 13 Oct 2026 12:45:11 -0500
Subject: [PATCH 05/14] win32: give a borderless window Windows' shadow when
 the gui asks

-setShadow:: did nothing on Windows, so the gui couldn't give its menus,
tool tips and flyouts the shadow Windows' own have.  DWM draws a shadow
(and on Windows 11 rounds the corners) only around a frame, and the
backend makes borderless windows without one.  CS_DROPSHADOW is per class
and isn't drawn under DWM on some systems.

-setShadow: YES : win now gives a borderless window a thick frame and a
caption, makes WM_NCCALCSIZE leave them no room so the client area stays
the whole window, answers WM_NCHITTEST with HTCLIENT so the frame neither
moves nor resizes it, and extends DWM's frame one pixel into the client
area, which brings DWM's shadow.  NO takes them away.  The window keeps
them through -stylewindow::, and isn't taken for a window whose client
draws its caption, or given a maximize box by -setmaxsize::.  A window
with a frame of its own is left alone: it has Windows' shadow already.
dwmapi.dll is loaded when first needed.

AI assistance: this change and its description were written with Claude
(Anthropic's Claude Code).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Headers/win32/WIN32Server.h |  1 +
 Source/win32/WIN32Server.m  | 88 +++++++++++++++++++++++++++++++++++--
 2 files changed, 86 insertions(+), 3 deletions(-)

diff --git a/Headers/win32/WIN32Server.h b/Headers/win32/WIN32Server.h
index 6ed9bea..c9a4eba 100644
--- a/Headers/win32/WIN32Server.h
+++ b/Headers/win32/WIN32Server.h
@@ -275,6 +275,7 @@ typedef struct _win_intern {
   NSRect *captionRects;            // set by -setCaptionRegionRects:...
   int *captionKinds;
   unsigned captionRegionCount;
+  BOOL hasShadowFrame;             // a borderless window given a shadow
 } WIN_INTERN;
 
 #endif /* _WIN32Server_h_INCLUDE */
diff --git a/Source/win32/WIN32Server.m b/Source/win32/WIN32Server.m
index 95d849f..4f02e5d 100644
--- a/Source/win32/WIN32Server.m
+++ b/Source/win32/WIN32Server.m
@@ -62,6 +62,7 @@
 #endif
 
 #include <math.h>
+#include <uxtheme.h>     // MARGINS, for DwmExtendFrameIntoClientArea
 
 // The Windows SDK declares BOOL as an int.  Objective C defines BOOl as a char.
 // Those two types clash.  MinGW's implementation of the Windows SDK uses the WINBOOL
@@ -208,12 +209,23 @@ BOOL CALLBACK LoadDisplayMonitorInfo(HMONITOR hMonitor,
   clientDrawsCaptions = flag;
 }
 
+/* Whether hwnd is a borderless window given a shadow (-setShadow::): it
+   has a frame for DWM's shadow, but its client area is the whole window. */
+static BOOL
+hasShadowFrame(HWND hwnd)
+{
+  WIN_INTERN *win = (WIN_INTERN *)GetWindowLongPtr(hwnd, GWLP_USERDATA);
+
+  return win != NULL && win->hasShadowFrame;
+}
+
 /* Whether hwnd keeps Windows' frame but has no caption of Windows': the
    gui draws it in the client area, which reaches the window's top. */
 - (BOOL) _clientDrawsCaptionOfWindow: (HWND)hwnd
 {
   return clientDrawsCaptions && handlesWindowDecorations
-    && (GetWindowLongPtr(hwnd, GWL_STYLE) & WS_CAPTION) == WS_CAPTION;
+    && (GetWindowLongPtr(hwnd, GWL_STYLE) & WS_CAPTION) == WS_CAPTION
+    && !hasShadowFrame(hwnd);
 }
 
 - (void) setCaptionRegionRects: (const NSRect *)rects
@@ -1313,7 +1325,9 @@ LRESULT CALLBACK windowEnumCallback(HWND hwnd, LPARAM lParam)
         return [self decodeWM_NCCREATEParams: wParam : lParam : hwnd];
         break;
       case WM_NCCALCSIZE:
-        if ([self _clientDrawsCaptionOfWindow: hwnd])
+        if (hasShadowFrame(hwnd))
+          flags._eventHandled = YES; // the client area is the whole window
+        else if ([self _clientDrawsCaptionOfWindow: hwnd])
           [self _calcClientDrawsCaptionSize: hwnd : wParam : lParam];
         else
           [self decodeWM_NCCALCSIZEParams: wParam : lParam : hwnd];
@@ -1485,6 +1499,8 @@ LRESULT CALLBACK windowEnumCallback(HWND hwnd, LPARAM lParam)
 	
       case WM_NCHITTEST: //MOUSE
         NSDebugLLog(@"NSEvent", @"Got Message %s for %d", "NCHITTEST", hwnd);
+        if (hasShadowFrame(hwnd))
+          return HTCLIENT; // the frame neither moves nor resizes it
         if ([self _clientDrawsCaptionOfWindow: hwnd])
           return [self _clientDrawsCaptionHitTest: hwnd : wParam : lParam];
         break;
@@ -1891,6 +1907,10 @@ LRESULT CALLBACK windowEnumCallback(HWND hwnd, LPARAM lParam)
 	   @"-stylewindow: : called when [self handlesWindowDecorations] == NO");
 
   NSDebugLLog(@"WTrace", @"stylewindow: %d : %d", style, winNum);
+  if (hasShadowFrame((HWND)winNum))
+    {
+      wstyle |= WS_CAPTION | WS_THICKFRAME;
+    }
   SetWindowLongPtr((HWND)winNum, GWL_STYLE, wstyle);
   SetWindowLongPtr((HWND)winNum, GWL_EXSTYLE, estyle);
 }
@@ -2373,7 +2393,8 @@ LRESULT CALLBACK windowEnumCallback(HWND hwnd, LPARAM lParam)
     {
       wanted &= ~WS_MAXIMIZEBOX;
     }
-  else if ((style & WS_THICKFRAME) && (style & WS_CAPTION) == WS_CAPTION)
+  else if ((style & WS_THICKFRAME) && (style & WS_CAPTION) == WS_CAPTION
+    && !win->hasShadowFrame)
     {
       wanted |= WS_MAXIMIZEBOX;
     }
@@ -2397,6 +2418,67 @@ LRESULT CALLBACK windowEnumCallback(HWND hwnd, LPARAM lParam)
   win->minmax.ptMinTrackSize = p;
 }
 
+/** Gives a borderless window a shadow, or takes it away, as Windows'
+ * menus, tool tips and flyouts have one.  DWM draws a shadow (and, on
+ * Windows 11, rounds the corners) only around a frame, so the window gets
+ * a thick frame and a caption that WM_NCCALCSIZE gives no room, and DWM's
+ * frame reaches one pixel into the client area.  The client area stays
+ * the whole window, and the frame neither moves nor resizes it.  A window
+ * with a frame of its own already has Windows' shadow.
+ */
+- (void) setShadow: (BOOL)hasShadow : (int)winNum
+{
+  typedef HRESULT (WINAPI *ExtendFrameFunc)(HWND, const MARGINS *);
+  static ExtendFrameFunc extendFrame = NULL;
+  static BOOL looked = NO;
+  HWND hwnd = (HWND)winNum;
+  WIN_INTERN *win = (WIN_INTERN *)GetWindowLongPtr(hwnd, GWLP_USERDATA);
+  LONG_PTR style;
+  MARGINS margins = {0, 0, 0, 0};
+
+  if (win == NULL || win->hasShadowFrame == hasShadow)
+    {
+      return;
+    }
+  style = GetWindowLongPtr(hwnd, GWL_STYLE);
+  if (hasShadow && (style & (WS_CAPTION | WS_THICKFRAME)) != 0)
+    {
+      return;
+    }
+  if (!looked)
+    {
+      HMODULE dwm = LoadLibraryA("dwmapi.dll");
+
+      looked = YES;
+      if (dwm != NULL)
+        {
+          extendFrame = (ExtendFrameFunc)(void *)GetProcAddress(dwm,
+            "DwmExtendFrameIntoClientArea");
+        }
+    }
+  if (extendFrame == NULL)
+    {
+      return;
+    }
+
+  NSDebugLLog(@"WTrace", @"setShadow: %d : %d", hasShadow, winNum);
+  win->hasShadowFrame = hasShadow;
+  if (hasShadow)
+    {
+      style |= WS_CAPTION | WS_THICKFRAME;
+      margins.cyBottomHeight = 1;
+    }
+  else
+    {
+      style &= ~(WS_CAPTION | WS_THICKFRAME);
+    }
+  SetWindowLongPtr(hwnd, GWL_STYLE, style);
+  extendFrame(hwnd, &margins);
+  SetWindowPos(hwnd, NULL, 0, 0, 0, 0,
+               SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE
+               | SWP_FRAMECHANGED);
+}
+
 /** Set the resize incremenet of the window */
 - (void) setresizeincrements: (NSSize)size : (int) winNum
 {
