{
    "schema_version": 1,
    "kind": "managed-toolchain",
    "toolchain_version": "2026.04.0",
    "target": {
        "id": "linux-arm64-clang",
        "os": "linux",
        "arch": "arm64",
        "compiler_family": "clang",
        "toolchain_flavor": "clang"
    },
    "runtime": {
        "objc_runtime": "libobjc2",
        "objc_abi": "modern",
        "required_features": [
            "blocks"
        ]
    },
    "components": [
        "libobjc2",
        "libdispatch",
        "tools-make",
        "libs-base",
        "libs-corebase",
        "libs-gui",
        "libs-back"
    ],
    "published": false,
    "platform_policy": {
        "supported_distributions": [
            "debian"
        ],
        "portability_policy": "distribution-scoped",
        "supported_distribution_releases": [
            "debian-13"
        ],
        "deprecated_distribution_releases": [
            "debian-12"
        ],
        "notes": "Planned Debian aarch64 managed target built on Debian 13 trixie (glibc 2.41, ICU 76); Debian 12 bookworm is deprecated and its ICU 72 artifacts do not load on Debian 13. Publish remains false until OracleTestVMs build/validation evidence exists."
    },
    "build_environment": {
        "base_image": "debian:13",
        "distribution": "debian",
        "distribution_release": "trixie",
        "dockerfile": "Dockerfile",
        "glibc_floor": "2.41",
        "icu_major": "76",
        "deprecated_bases": [
            "debian:12"
        ]
    },
    "source_policy": {
        "strategy": "source-build",
        "production_eligible": true,
        "lock_file": "source-lock.json",
        "component_inventory": "component-inventory.json",
        "host_origin_paths_allowed": false
    }
}
