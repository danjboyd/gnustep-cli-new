From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Boyd <danboyd2@gmail.com>
Date: Fri, 6 Nov 2026 10:53:41 -0600
Subject: [PATCH] On Windows, also trust the bundled authorities

Windows adds many trusted roots to its store only on demand, when its own
chain building first needs one, so gnutls's view of the store can lack the
root a valid server chains to. Load the base library's GSTLS bundle in
addition to the store.
---
 Source/GSTLS.m | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/Source/GSTLS.m b/Source/GSTLS.m
index 08fc8b5a3..fc0fbf27d 100644
--- a/Source/GSTLS.m
+++ b/Source/GSTLS.m
@@ -1278,6 +1278,46 @@ static GSTLSDHParams            *paramsCurrent = nil;
 		{
 		  c->trust = YES;   // Loaded at least one trusted CA
 		}
+#if defined(_WIN32)
+	      /* Windows adds many trusted roots to its store only on demand,
+	       * when its own chain building first needs one, so a valid server
+	       * may chain to a root that is not in the store yet.  Also load
+	       * the base library's bundled authorities; gnutls adds them to the
+	       * same trust list, so roots from the store are still trusted.
+	       */
+	      {
+		NSBundle	*bundle = [NSBundle bundleForClass: [NSObject class]];
+		NSString	*str;
+
+		str = [bundle pathForResource: @"ca-certificates"
+				       ofType: @"crt"
+				  inDirectory: @"GSTLS"];
+		if (nil != str)
+		  {
+		    str = standardizedPath(str);
+		    path = [str gnutlsFileSystemRepresentation];
+		    ret = gnutls_certificate_set_x509_trust_file(c->certcred,
+		      path, GNUTLS_X509_FMT_PEM);
+		    if (ret < 0)
+		      {
+			NSLog(@"Problem loading trusted authorities from %@: %s",
+			  str, gnutls_strerror(ret));
+		      }
+		    else
+		      {
+			if (debug)
+			  {
+			    NSLog(@"Default trusted authorities (from base) %d",
+			      ret);
+			  }
+			if (ret > 0)
+			  {
+			    c->trust = YES;
+			  }
+		      }
+		  }
+	      }
+#endif
 	    }
 	}
 
